@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Welcome";
}

<section class="hero">

    <div class="container text-center">

        <h1 class="hero-title">
            Smart Inventory
            <br />
            Management System
        </h1>

        <p class="hero-text mt-4">

            Manage products, sales, suppliers,
            purchases and inventory easily.

        </p>

        <div class="mt-5">

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-success btn-lg mr-3">

                Get Started

            </a>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-light btn-lg">

                Sign In

            </a>

        </div>

    </div>

</section>


<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="font-weight-bold">
                Powerful Features
            </h2>

            <p class="text-muted">
                Everything you need to manage inventory smarter.
            </p>

        </div>

        <div class="row">

            <div class="col-md-4 mb-4">

                <div class="card p-4 h-100">

                    <i class="fas fa-box fa-2x text-primary mb-3"></i>

                    <h4>Inventory Tracking</h4>

                    <p class="text-muted">
                        Track products and stock levels in real-time.
                    </p>

                </div>

            </div>

            <div class="col-md-4 mb-4">

                <div class="card p-4 h-100">

                    <i class="fas fa-chart-line fa-2x text-success mb-3"></i>

                    <h4>Analytics</h4>

                    <p class="text-muted">
                        Powerful reports and sales analytics dashboard.
                    </p>

                </div>

            </div>

            <div class="col-md-4 mb-4">

                <div class="card p-4 h-100">

                    <i class="fas fa-user-shield fa-2x text-info mb-3"></i>

                    <h4>Secure Access</h4>

                    <p class="text-muted">
                        JWT authentication and role-based security.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>