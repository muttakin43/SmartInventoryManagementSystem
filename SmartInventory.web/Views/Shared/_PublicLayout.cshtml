<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Smart Inventory</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/plugins/bootstrap/css/bootstrap.min.css">

    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">

    <style>

        body {
            background: #0d1117;
            color: #c9d1d9;
            font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                width: 600px;
                height: 600px;
                background: rgba(88,166,255,.12);
                filter: blur(120px);
                top: -200px;
                left: -200px;
                z-index: -1;
            }

            body::after {
                content: '';
                position: fixed;
                width: 500px;
                height: 500px;
                background: rgba(35,134,54,.10);
                filter: blur(120px);
                bottom: -200px;
                right: -200px;
                z-index: -1;
            }

        .navbar {
            background: rgba(13,17,23,.8) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #30363d;
        }

        .navbar-brand {
            font-size: 22px;
            font-weight: 700;
        }

        .nav-link {
            color: #c9d1d9 !important;
            transition: .3s;
        }

            .nav-link:hover {
                color: #58a6ff !important;
            }

        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-title {
            font-size: 72px;
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -2px;
        }

        .hero-text {
            font-size: 20px;
            color: #8b949e;
            max-width: 700px;
            margin: auto;
        }

        .btn-success {
            background: linear-gradient(135deg,#238636,#2ea043);
            border: none;
            border-radius: 12px;
            padding: 14px 28px;
            font-weight: 600;
        }

        .btn-outline-light {
            border-radius: 12px;
            padding: 14px 28px;
        }

        .card {
            background: rgba(22,27,34,.75);
            border: 1px solid #30363d;
            backdrop-filter: blur(12px);
            color: #c9d1d9;
            border-radius: 18px;
        }

        .card-footer,
        .card-header {
            border-color: #30363d !important;
        }

        .form-control,
        .input-group-text {
            background: #0d1117 !important;
            border: 1px solid #30363d !important;
            color: #c9d1d9 !important;
        }

            .form-control:focus {
                background: #161b22 !important;
                border-color: #58a6ff !important;
                box-shadow: 0 0 0 .2rem rgba(88,166,255,.15);
            }

            .form-control::placeholder {
                color: #6e7681;
            }

        footer {
            border-top: 1px solid #30363d;
            color: #8b949e;
            background: rgba(13,17,23,.6);
            backdrop-filter: blur(10px);
        }

    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-md navbar-dark" style="background:#0d1117;">

        <div class="container">

            <a class="navbar-brand font-weight-bold" asp-controller="Home" asp-action="Landing">
                <i class="fas fa-boxes mr-2"></i> Smart Inventory
            </a>

            <!-- Center Menu -->
            <ul class="navbar-nav mx-auto d-none d-md-flex">
                <li class="nav-item"><a class="nav-link text-white" href="#">Features</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="#">Pricing</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="#">Docs</a></li>
            </ul>

            <!-- Right Auth -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Sign In</a>
                </li>

                <li class="nav-item ml-2">
                    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Register">
                        Sign Up
                    </a>
                </li>
            </ul>

        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="text-center p-4">
        <div class="container">
            <small>© 2026 Smart Inventory System • Built with ASP.NET Core</small>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>