@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Check Your Email - Inventra</title>
</head>
<body>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #0d1117;
            font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        }

        .wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .box {
            width: 100%;
            max-width: 400px;
            text-align: center;
        }

        .icon {
            width: 56px;
            height: 56px;
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }

            .icon svg {
                width: 28px;
                height: 28px;
                stroke: #58a6ff;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f0f6fc;
            margin-bottom: 8px;
        }

        p {
            font-size: 14px;
            color: #8b949e;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .success-box {
            background: #0d1f0d;
            border: 1px solid #238636;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 13px;
            color: #3fb950;
            margin-bottom: 1.5rem;
        }

        .divider {
            height: 1px;
            background: #21262d;
            margin: 1.5rem 0;
        }

        .btn {
            display: inline-block;
            padding: 10px 24px;
            background: #1f6feb;
            color: #fff;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: background .15s;
        }

            .btn:hover {
                background: #388bfd;
            }

        .note {
            font-size: 12px;
            color: #6e7681;
            margin-top: 1rem;
        }
    </style>

    <div class="wrap">
        <div class="box">

            <!-- Email Icon -->
            <div class="icon">
                <svg viewBox="0 0 24 24">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                </svg>
            </div>

            <h1>Check your email</h1>

            <div class="success-box">
                ✅ @TempData["Message"]
            </div>

            <p>
                We've sent a password reset link to your email address.
                Please check your inbox and click the link to reset your password.
            </p>

            <div class="divider"></div>

            <a asp-action="Login" asp-controller="Account" class="btn">
                ← Back to Sign in
            </a>

            <p class="note">
                Didn't receive the email? Check your spam folder or
                <a asp-action="ForgotPassword" style="color:#58a6ff;text-decoration:none;">
                    try again
                </a>.
            </p>

        </div>
    </div>

</body>
</html>