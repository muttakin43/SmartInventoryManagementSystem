@model SmartInventory.Contract.Request.Account.LoginModel

@{
    Layout = "_PublicLayout";
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .si-login-page {
        display: flex;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: #0d1117;
    }

    /* ── Left branding panel ── */
    .si-left {
        width: 420px;
        flex-shrink: 0;
        background: #111827;
        border-right: 1px solid #21262d;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 3rem 2.5rem;
    }

    .si-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 3rem;
        text-decoration: none;
    }

    .si-brand-icon {
        width: 36px;
        height: 36px;
        background: #1f6feb;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .si-brand-icon svg {
            width: 20px;
            height: 20px;
            stroke: #ffffff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .si-brand-name {
        font-size: 18px;
        font-weight: 600;
        color: #f0f6fc;
        letter-spacing: -0.3px;
    }

    .si-tagline {
        margin-bottom: 2.5rem;
    }

        .si-tagline h2 {
            font-size: 26px;
            font-weight: 600;
            color: #f0f6fc;
            line-height: 1.35;
            letter-spacing: -0.5px;
            margin-bottom: 0.75rem;
        }

        .si-tagline p {
            font-size: 14px;
            color: #8b949e;
            line-height: 1.6;
        }

    .si-features {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: 3rem;
    }

    .si-feat {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .si-feat-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: #161b22;
        border: 1px solid #30363d;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

        .si-feat-icon svg {
            width: 16px;
            height: 16px;
            stroke: #58a6ff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .si-feat-text h4 {
        font-size: 13px;
        font-weight: 600;
        color: #e6edf3;
        margin-bottom: 2px;
    }

    .si-feat-text p {
        font-size: 12px;
        color: #6e7681;
        line-height: 1.4;
        margin: 0;
    }

    .si-trust {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .si-trust-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #1f6feb;
        flex-shrink: 0;
    }

    .si-trust p {
        font-size: 12px;
        color: #6e7681;
        margin: 0;
    }

    .si-trust span {
        color: #58a6ff;
    }

    /* ── Right form panel ── */
    .si-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #0d1117;
    }

    .si-form-box {
        width: 100%;
        max-width: 360px;
    }

    .si-form-header {
        margin-bottom: 1.75rem;
    }

        .si-form-header h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f0f6fc;
            margin-bottom: 6px;
            letter-spacing: -0.3px;
        }

        .si-form-header p {
            font-size: 13px;
            color: #8b949e;
            margin: 0;
        }

            .si-form-header p a {
                color: #58a6ff;
                text-decoration: none;
            }

                .si-form-header p a:hover {
                    text-decoration: underline;
                }

    /* Validation summary */
    .si-err-banner {
        background: #160b0b;
        border: 1px solid #6e2222;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 12px;
        color: #f85149;
        margin-bottom: 14px;
    }

        .si-err-banner:empty {
            display: none;
        }

    /* Fields */
    .si-field {
        margin-bottom: 14px;
    }

        .si-field label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 600;
            color: #e6edf3;
            margin-bottom: 6px;
            letter-spacing: 0.2px;
        }

        .si-field .form-control {
            width: 100%;
            height: 34px;
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 0 12px;
            color: #f0f6fc;
            font-size: 13px;
            outline: none;
            font-family: inherit;
            transition: border-color .15s, box-shadow .15s;
            box-shadow: none;
        }

            .si-field .form-control::placeholder {
                color: #484f58;
            }

            .si-field .form-control:focus {
                border-color: #388bfd;
                box-shadow: 0 0 0 3px rgba(56, 139, 253, .12);
                background: #161b22;
                color: #f0f6fc;
            }

    /* Password wrapper */
    .si-pw-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

        .si-pw-wrap .form-control {
            padding-right: 38px;
        }

    .si-pw-toggle {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        color: #6e7681;
        cursor: pointer;
        display: flex;
        align-items: center;
        padding: 0;
        transition: color .15s;
    }

        .si-pw-toggle:hover {
            color: #e6edf3;
        }

        .si-pw-toggle svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    /* Validation messages */
    .si-field .text-danger {
        display: block;
        font-size: 11px;
        color: #f85149;
        margin-top: 4px;
    }

    /* Remember me row */
    .si-row-between {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .si-remember {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: #8b949e;
        cursor: pointer;
        margin: 0;
    }

        .si-remember input[type="checkbox"] {
            width: 14px;
            height: 14px;
            accent-color: #1f6feb;
            cursor: pointer;
        }

    .si-forgot {
        font-size: 12px;
        color: #58a6ff;
        text-decoration: none;
    }

        .si-forgot:hover {
            text-decoration: underline;
        }

    /* Divider */
    .si-divider {
        height: 1px;
        background: #21262d;
        margin: 1.25rem 0;
    }

    /* Submit */
    .si-submit {
        width: 100%;
        height: 34px;
        background: #1f6feb;
        color: #ffffff;
        border: 1px solid rgba(240, 246, 252, .1);
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: background .15s;
        letter-spacing: 0.1px;
    }

        .si-submit:hover {
            background: #388bfd;
        }

        .si-submit:active {
            background: #1f6feb;
            transform: scale(.99);
        }

    /* Terms */
    .si-terms {
        margin-top: 1rem;
        font-size: 11px;
        color: #6e7681;
        text-align: center;
        line-height: 1.6;
    }

        .si-terms a {
            color: #58a6ff;
            text-decoration: none;
        }

            .si-terms a:hover {
                text-decoration: underline;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .si-left {
            display: none;
        }

        .si-right {
            padding: 1.5rem 1rem;
            align-items: flex-start;
            padding-top: 3rem;
        }
    }
</style>

<div class="si-login-page">

   

    <!-- ── Right form panel ── -->
    <main class="si-right">
        <div class="si-form-box">

            <div class="si-form-header  text-center">
                <h1>Sign in to your account</h1>
                <p>Don't have an account? <a asp-action="Register">Create one</a></p>
            </div>

            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly" class="si-err-banner"></div>

                <!-- Email -->
                <div class="si-field">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="john@company.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="si-field">
                    <label asp-for="Password">
                        <span>Password</span>
                        <a href="#" class="si-forgot">Forgot password?</a>
                    </label>
                    <div class="si-pw-wrap">
                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button"
                                class="si-pw-toggle"
                                onclick="togglePassword()"
                                aria-label="Toggle password visibility">
                            <svg id="eyeShow" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="eyeHide" viewBox="0 0 24 24" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Remember me -->
                <div class="si-row-between">
                    <label class="si-remember">
                        <input type="checkbox" asp-for="RememberMe" />
                        Remember me
                    </label>
                </div>

                <div class="si-divider"></div>

                <button type="submit" class="si-submit">Sign in</button>

                <p class="si-terms">
                    By signing in, you agree to our
                    <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                </p>

            </form>
        </div>
    </main>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword() {
            var input = document.getElementById("passwordInput");
            var showIcon = document.getElementById("eyeShow");
            var hideIcon = document.getElementById("eyeHide");

            if (input.type === "password") {
                input.type = "text";
                showIcon.style.display = "none";
                hideIcon.style.display = "block";
            } else {
                input.type = "password";
                showIcon.style.display = "block";
                hideIcon.style.display = "none";
            }
        }
    </script>
}
