@model SmartInventory.Contract.Request.Account.ForgetPasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot Password - Inventra</title>
</head>
<body>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #0d1117;
            font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        }

        .wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .box {
            width: 100%;
            max-width: 380px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f0f6fc;
            margin-bottom: 6px;
        }

        .sub {
            font-size: 13px;
            color: #8b949e;
            margin-bottom: 1.75rem;
            line-height: 1.6;
        }

            .sub a {
                color: #58a6ff;
                text-decoration: none;
            }

                .sub a:hover {
                    text-decoration: underline;
                }

        .field {
            margin-bottom: 14px;
        }

            .field label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: #e6edf3;
                margin-bottom: 6px;
            }

            .field input {
                width: 100%;
                height: 34px;
                background: #161b22;
                border: 1px solid #30363d;
                border-radius: 6px;
                padding: 0 12px;
                color: #f0f6fc;
                font-size: 13px;
                outline: none;
                font-family: inherit;
                transition: border-color .15s, box-shadow .15s;
            }

                .field input:focus {
                    border-color: #388bfd;
                    box-shadow: 0 0 0 3px rgba(56,139,253,.12);
                }

                .field input::placeholder {
                    color: #484f58;
                }

            .field .text-danger {
                display: block;
                font-size: 11px;
                color: #f85149;
                margin-top: 4px;
            }

        .err {
            background: #160b0b;
            border: 1px solid #6e2222;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 12px;
            color: #f85149;
            margin-bottom: 14px;
        }

            .err:empty {
                display: none;
            }

        .success-box {
            background: #0d1f0d;
            border: 1px solid #238636;
            border-radius: 8px;
            padding: 16px;
            font-size: 13px;
            color: #3fb950;
            text-align: center;
            margin-bottom: 14px;
        }

        .divider {
            height: 1px;
            background: #21262d;
            margin: 1.25rem 0;
        }

        .btn {
            width: 100%;
            height: 36px;
            background: #1f6feb;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background .15s;
        }

            .btn:hover {
                background: #388bfd;
            }
    </style>

    <div class="wrap">
        <div class="box">

            <h1>Forgot your password?</h1>
            <p class="sub">
                Enter your email and we'll send you a reset link.<br>
                <a asp-action="Login">← Back to Sign in</a>
            </p>

            @if (TempData["Message"] != null)
            {
                <div class="success-box">
                    ✅ @TempData["Message"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="err"></div>

                <div class="field">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email"
                           placeholder="Enter your email"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="divider"></div>

                <button type="submit" class="btn">Send reset link</button>
            </form>

        </div>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>