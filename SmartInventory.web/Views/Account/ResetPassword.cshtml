@model SmartInventory.Contract.Request.Account.ResetPasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reset Password - Inventra</title>
</head>
<body>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #0d1117;
            font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        }

        .wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .box {
            width: 100%;
            max-width: 380px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f0f6fc;
            margin-bottom: 6px;
        }

        .sub {
            font-size: 13px;
            color: #8b949e;
            margin-bottom: 1.75rem;
        }

        .field {
            margin-bottom: 14px;
        }

            .field label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: #e6edf3;
                margin-bottom: 6px;
            }

            .field input {
                width: 100%;
                height: 34px;
                background: #161b22;
                border: 1px solid #30363d;
                border-radius: 6px;
                padding: 0 38px 0 12px;
                color: #f0f6fc;
                font-size: 13px;
                outline: none;
                font-family: inherit;
                transition: border-color .15s, box-shadow .15s;
            }

                .field input:focus {
                    border-color: #388bfd;
                    box-shadow: 0 0 0 3px rgba(56,139,253,.12);
                }

                .field input::placeholder {
                    color: #484f58;
                }

            .field .text-danger {
                display: block;
                font-size: 11px;
                color: #f85149;
                margin-top: 4px;
            }

        .pw-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .pw-toggle {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            color: #6e7681;
            cursor: pointer;
            display: flex;
            align-items: center;
            padding: 0;
            transition: color .15s;
        }

            .pw-toggle:hover {
                color: #e6edf3;
            }

            .pw-toggle svg {
                width: 15px;
                height: 15px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .err {
            background: #160b0b;
            border: 1px solid #6e2222;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 12px;
            color: #f85149;
            margin-bottom: 14px;
        }

            .err:empty {
                display: none;
            }

        .divider {
            height: 1px;
            background: #21262d;
            margin: 1.25rem 0;
        }

        .btn {
            width: 100%;
            height: 36px;
            background: #238636;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background .15s;
        }

            .btn:hover {
                background: #2ea043;
            }
    </style>

    <div class="wrap">
        <div class="box">

            <h1>Set new password</h1>
            <p class="sub">Choose a strong password for your account.</p>

            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="err"></div>

                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <!-- New Password -->
                <div class="field">
                    <label asp-for="NewPassword">New password</label>
                    <div class="pw-wrap">
                        <input asp-for="NewPassword" type="password"
                               id="pw1" placeholder="Enter new password" />
                        <button type="button" class="pw-toggle"
                                onclick="toggle('pw1','s1','h1')">
                            <svg id="s1" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="h1" viewBox="0 0 24 24" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="pw-wrap">
                        <input asp-for="ConfirmPassword" type="password"
                               id="pw2" placeholder="Repeat new password" />
                        <button type="button" class="pw-toggle"
                                onclick="toggle('pw2','s2','h2')">
                            <svg id="s2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="h2" viewBox="0 0 24 24" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="divider"></div>
                <button type="submit" class="btn">Reset password</button>
            </form>

        </div>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function toggle(inputId, showId, hideId) {
            var input = document.getElementById(inputId);
            var s = document.getElementById(showId);
            var h = document.getElementById(hideId);
            if (input.type === "password") {
                input.type = "text";
                s.style.display = "none";
                h.style.display = "block";
            } else {
                input.type = "password";
                s.style.display = "block";
                h.style.display = "none";
            }
        }
    </script>
</body>
</html>