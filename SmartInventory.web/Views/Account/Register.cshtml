@model SmartInventory.Contract.Request.Account.RegisterModel

@{
    Layout = "_PublicLayout";
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .si-register-page {
        display: flex;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: #0d1117;
    }

    /* ── Left branding panel ── */
    .si-left {
        flex: 1;
        background: #111827;
        border-right: 1px solid #21262d;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 3rem 2.5rem;
    }

    .si-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 3rem;
        text-decoration: none;
    }

    .si-brand-icon {
        width: 36px;
        height: 36px;
        background: #238636;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .si-brand-icon svg {
            width: 20px;
            height: 20px;
        }

    .si-brand-name {
        font-size: 18px;
        font-weight: 600;
        color: #f0f6fc;
        letter-spacing: -0.3px;
    }

    .si-tagline {
        margin-bottom: 2.5rem;
    }

        .si-tagline h2 {
            font-size: 26px;
            font-weight: 600;
            color: #f0f6fc;
            line-height: 1.35;
            letter-spacing: -0.5px;
            margin-bottom: 0.75rem;
        }

        .si-tagline p {
            font-size: 14px;
            color: #8b949e;
            line-height: 1.6;
        }

    .si-features {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: 3rem;
    }

    .si-feat {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .si-feat-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: #161b22;
        border: 1px solid #30363d;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

        .si-feat-icon svg {
            width: 16px;
            height: 16px;
            stroke: #3fb950;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .si-feat-text h4 {
        font-size: 13px;
        font-weight: 600;
        color: #e6edf3;
        margin-bottom: 2px;
    }

    .si-feat-text p {
        font-size: 12px;
        color: #6e7681;
        line-height: 1.4;
        margin: 0;
    }

    .si-trust {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .si-trust-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #238636;
        flex-shrink: 0;
    }

    .si-trust p {
        font-size: 12px;
        color: #6e7681;
        margin: 0;
    }

    .si-trust span {
        color: #3fb950;
    }

    /* ── Right form panel ── */
    .si-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #0d1117;
    }

    .si-form-box {
        width: 100%;
        max-width: 380px;
    }

    .si-form-header {
        margin-bottom: 1.75rem;
    }

        .si-form-header h1 {
            font-size: 22px;
            font-weight: 600;
            color: #f0f6fc;
            margin-bottom: 6px;
            letter-spacing: -0.3px;
        }

        .si-form-header p {
            font-size: 13px;
            color: #8b949e;
            margin: 0;
        }

            .si-form-header p a {
                color: #3fb950;
                text-decoration: none;
            }

                .si-form-header p a:hover {
                    text-decoration: underline;
                }

    /* Validation summary override */
    .si-err-banner {
        background: #160b0b;
        border: 1px solid #6e2222;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 12px;
        color: #f85149;
        margin-bottom: 14px;
    }

        .si-err-banner:empty {
            display: none;
        }

    /* Field grid */
    .si-field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 14px;
    }

    .si-field {
        margin-bottom: 14px;
    }

        .si-field label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #e6edf3;
            margin-bottom: 6px;
            letter-spacing: 0.2px;
        }

        .si-field .form-control {
            width: 100%;
            height: 34px;
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 0 12px;
            color: #f0f6fc;
            font-size: 13px;
            outline: none;
            font-family: inherit;
            transition: border-color .15s, box-shadow .15s;
            box-shadow: none;
        }

            .si-field .form-control::placeholder {
                color: #484f58;
            }

            .si-field .form-control:focus {
                border-color: #388bfd;
                box-shadow: 0 0 0 3px rgba(56, 139, 253, .12);
                background: #161b22;
                color: #f0f6fc;
            }

    /* Password wrapper */
    .si-pw-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

        .si-pw-wrap .form-control {
            padding-right: 38px;
        }

    .si-pw-toggle {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        color: #6e7681;
        cursor: pointer;
        display: flex;
        align-items: center;
        padding: 0;
        transition: color .15s;
    }

        .si-pw-toggle:hover {
            color: #e6edf3;
        }

        .si-pw-toggle svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    /* Validation messages */
    .si-field .text-danger {
        display: block;
        font-size: 11px;
        color: #f85149;
        margin-top: 4px;
    }

    /* Divider */
    .si-divider {
        height: 1px;
        background: #21262d;
        margin: 1.25rem 0;
    }

    /* Submit */
    .si-submit {
        width: 100%;
        height: 34px;
        background: #238636;
        color: #ffffff;
        border: 1px solid rgba(240, 246, 252, .1);
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: background .15s;
        letter-spacing: 0.1px;
    }

        .si-submit:hover {
            background: #2ea043;
        }

        .si-submit:active {
            background: #238636;
            transform: scale(.99);
        }

    /* Terms */
    .si-terms {
        margin-top: 1rem;
        font-size: 11px;
        color: #6e7681;
        text-align: center;
        line-height: 1.6;
    }

        .si-terms a {
            color: #3fb950;
            text-decoration: none;
        }

            .si-terms a:hover {
                text-decoration: underline;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .si-left {
            display: none;
        }

        .si-right {
            padding: 1.5rem 1rem;
            align-items: flex-start;
            padding-top: 3rem;
        }
    }
</style>

<div class="si-register-page">

    <!-- ── Left branding panel ── -->
    <aside class="si-left">
        <div>
         

            <div class="si-tagline">
                <h2>Take control of your inventory, intelligently.</h2>
                <p>Real-time tracking, smart alerts, and powerful analytics — all in one platform.</p>
            </div>

            <div class="si-features">
                <div class="si-feat">
                    <div class="si-feat-icon">
                        <svg viewBox="0 0 24 24">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                    </div>
                    <div class="si-feat-text">
                        <h4>Real-time stock tracking</h4>
                        <p>Monitor inventory levels across all locations instantly.</p>
                    </div>
                </div>
                <div class="si-feat">
                    <div class="si-feat-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 20V10M12 20V4M6 20v-6" />
                        </svg>
                    </div>
                    <div class="si-feat-text">
                        <h4>Smart analytics &amp; reports</h4>
                        <p>Data-driven insights to optimize purchasing decisions.</p>
                    </div>
                </div>
                <div class="si-feat">
                    <div class="si-feat-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M22 17H2a3 3 0 000 6h20a3 3 0 000-6z" />
                            <path d="M12 17V3M5 10l7-7 7 7" />
                        </svg>
                    </div>
                    <div class="si-feat-text">
                        <h4>Automated low-stock alerts</h4>
                        <p>Never run out of critical stock with smart notifications.</p>
                    </div>
                </div>
                <div class="si-feat">
                    <div class="si-feat-icon">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                            <path d="M3 9h18M9 21V9" />
                        </svg>
                    </div>
                    <div class="si-feat-text">
                        <h4>Multi-warehouse management</h4>
                        <p>Manage stock across multiple locations from one dashboard.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="si-trust">
            <div class="si-trust-dot"></div>
            <p>Trusted by <span>2,400+</span> businesses worldwide</p>
        </div>
    </aside>

    <!-- ── Right form panel ── -->
    <main class="si-right">
        <div class="si-form-box">

            <div class="si-form-header">
                <h1>Create your account</h1>
                <p>Already have an account? <a asp-action="Login">Sign in</a></p>
            </div>

            <form asp-action="Register" method="post">

                <div asp-validation-summary="ModelOnly" class="si-err-banner"></div>

                <!-- Name row -->
                <div class="si-field-row">
                    <div class="si-field">
                        <label asp-for="FirstName">First name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="John" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="si-field">
                        <label asp-for="LastName">Last name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Doe" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="si-field">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" class="form-control" placeholder="john@company.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="si-field">
                    <label asp-for="Password">Password</label>
                    <div class="si-pw-wrap">
                        <input asp-for="Password" type="password" id="password" class="form-control"
                               placeholder="Min. 8 characters" autocomplete="new-password" />
                        <button type="button" class="si-pw-toggle"
                                onclick="togglePassword('password','icon1show','icon1hide')"
                                aria-label="Toggle password visibility">
                            <svg id="icon1show" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="icon1hide" viewBox="0 0 24 24" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="si-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="si-pw-wrap">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control"
                               placeholder="Repeat your password" autocomplete="new-password" />
                        <button type="button" class="si-pw-toggle"
                                onclick="togglePassword('confirmPassword','icon2show','icon2hide')"
                                aria-label="Toggle confirm password visibility">
                            <svg id="icon2show" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg id="icon2hide" viewBox="0 0 24 24" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="si-divider"></div>

                <button type="submit" class="si-submit">Create account</button>

                <p class="si-terms">
                    By creating an account, you agree to our
                    <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                </p>

            </form>
        </div>
    </main>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword(inputId, showIconId, hideIconId) {
            var input = document.getElementById(inputId);
            var showIcon = document.getElementById(showIconId);
            var hideIcon = document.getElementById(hideIconId);

            if (input.type === "password") {
                input.type = "text";
                showIcon.style.display = "none";
                hideIcon.style.display = "block";
            } else {
                input.type = "password";
                showIcon.style.display = "block";
                hideIcon.style.display = "none";
            }
        }
    </script>
}
